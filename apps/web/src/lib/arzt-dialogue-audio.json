{
  "doctor:Guten Tag! Wie geht es Ihnen? Was tut Ihnen weh?": "/audio/arzt-dialogues/ddeab86bf3a5af3f.mp3",
  "patient:Guten Tag. Ich habe seit drei Tagen Bauchschmerzen. Mir ist auch schlecht.": "/audio/arzt-dialogues/64e31601bd9cd1e7.mp3",
  "doctor:Haben Sie Fieber?": "/audio/arzt-dialogues/c5c20ab93f207429.mp3",
